{
  "name": "vscode-editor-switcher",
  "publisher": "mikejhill",
  "version": "0.0.0",
  "displayName": "Editor Switcher",
  "description": "Quickly switch between open editors with a QuickPick. Provides an enhanced switcher experience, including closing the highlighted editor without leaving the picker.",
  "repository": "https://github.com/mikejhill/vscode-editor-switcher",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon-256.png",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "editor",
    "switcher",
    "picker"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "editor-switcher.open",
        "title": "%command.open%"
      },
      {
        "command": "editor-switcher.closeSelected",
        "title": "%command.closeSelected%",
        "enablement": "editorSwitcherVisible"
      }
    ],
    "keybindings": [
      {
        "command": "editor-switcher.open",
        "key": "ctrl+alt+e"
      },
      {
        "command": "editor-switcher.closeSelected",
        "key": "ctrl+w",
        "when": "editorSwitcherVisible"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "editor-switcher.onCloseKeepGroupFocus": {
          "type": "boolean",
          "description": "%configuration.onCloseKeepGroupFocus.description%",
          "order": 10,
          "default": true,
          "scope": "window"
        },
        "editor-switcher.onCloseSelectTabStrategy": {
          "type": "string",
          "description": "%configuration.onCloseSelectTabStrategy.description%",
          "order": 20,
          "default": "selectNext",
          "enum": [
            "selectNext",
            "selectPrevious"
          ],
          "enumItemLabels": [
            "%configuration.onCloseSelectTabStrategy.selectNextLabel%",
            "%configuration.onCloseSelectTabStrategy.selectPreviousLabel%"
          ],
          "enumDescriptions": [
            "%configuration.onCloseSelectTabStrategy.selectNext%",
            "%configuration.onCloseSelectTabStrategy.selectPrevious%"
          ],
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npx @vscode/vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "generate:icons": "node scripts/generate-icons.js --src images/icon-source.png --out images --sizes 256"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.2",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "sinon": "^17.0.1",
    "jimp": "^0.22.10"
  }
}